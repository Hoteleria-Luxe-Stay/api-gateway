# ============================================================
# api-gateway - DEV environment template
# ------------------------------------------------------------
# Copy this file to .env (in this same folder) and load it
# from your IDE Run Configuration (e.g. EnvFile plugin in IntelliJ).
# Defaults in YAML are PROD-safe; this file overrides for DEV.
# ============================================================

# --- Spring Cloud Config Server ---
# DEV: config-server runs locally from IDE
CONFIG_IMPORT=optional:configserver:http://localhost:8888
CONFIG_FAIL_FAST=false

# --- Server ---
SERVER_PORT=8080

# --- Eureka discovery ---
# DEV: discovery-service runs locally from IDE
EUREKA_URL=http://localhost:8761/eureka

# --- CORS ---
# DEV: Angular dev server
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Logging (DEV verbose) ---
LOG_LEVEL_GATEWAY=DEBUG
LOG_LEVEL_NETTY=DEBUG

# --- JWT ---
# RSA public key in PEM format. Use literal \n for line breaks if single-line.
# Must match the private key used by auth-service.
JWT_PUBLIC_KEY=

# --- Redis (Idempotency-Key store, Round 5.3) ---
# DEV: redis runs in docker-compose.infra.yml on port 6379
REDIS_HOST=localhost
REDIS_PORT=6379
# IDEMPOTENCY_TTL_HOURS=24
